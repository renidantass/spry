from __future__ import annotations

from spry.auth import CookieAuthService, PasswordHasher, authorize
from spry.controllers import AuthenticatedController
from spry.http import Request
from spry.routing import controller, get, post
from spry.views import HtmlString, ViewRenderer

from __PACKAGE_NAME__.data import AppDbContext


@controller("")
class AccountController(AuthenticatedController):
    def __init__(self, view_renderer: ViewRenderer, auth: CookieAuthService, db: AppDbContext) -> None:
        super().__init__(view_renderer, auth)
        self.db = db
        self.hasher = PasswordHasher()

    @get("/login")
    def login(self):
        return self._render_login(None)

    @post("/login")
    def login_post(self, request: Request):
        form = request.form()
        username = (form.get("username") or "").strip()
        password = (form.get("password") or "").strip()
        if not username or not password:
            return self._render_login("Informe usuario e senha.", status_code=400)

        user = self.db.users.first(username=username)
        if user is None or not self.hasher.verify(password, user.password_hash):
            return self._render_login("Usuario ou senha invalidos.", status_code=401)

        response = self.redirect("/")
        return self.sign_in(response, user_id=str(user.id), name=user.display_name, claims={"role": user.roles})

    @post("/logout")
    @authorize()
    def logout(self):
        response = self.redirect("/login")
        return self.sign_out(response)

    def _render_login(self, error: str | None, *, status_code: int = 200):
        error_block = self.partial_view("shared/_alert", {"message": error}) if error else HtmlString("")
        return self.view("account/login", {"page_title": "Entrar", "error_block": error_block}, status_code=status_code)
