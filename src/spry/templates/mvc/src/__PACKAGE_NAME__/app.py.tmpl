from __future__ import annotations

from pathlib import Path

from spry import AppBuilder

from __PACKAGE_NAME__.data import AppDbContext


BASE_DIR = Path(__file__).resolve().parents[2]


def create_app():
    builder = AppBuilder(base_path=BASE_DIR)
    builder.add_views(root_path=BASE_DIR)
    builder.add_auth()
    builder.add_csrf()
    builder.add_db_context(AppDbContext)
    builder.discover_controllers("__PACKAGE_NAME__")
    app = builder.build()

    scope = app.create_scope()
    try:
        db = scope.resolve(AppDbContext)
        db.ensure_created()
    finally:
        scope.dispose()

    return app
