from dataclasses import dataclass

from spry import DbContext, column, dbset, key


@dataclass(slots=True)
class Todo:
    id: int | None = key()
    title: str = ""
    description: str = ""
    done: bool = False


@dataclass(slots=True)
class User:
    id: int | None = key()
    username: str = column(unique=True, default="")
    display_name: str = ""
    password_hash: str = ""
    roles: str = "member"


class AppDbContext(DbContext):
    todos = dbset(Todo)
    users = dbset(User)
