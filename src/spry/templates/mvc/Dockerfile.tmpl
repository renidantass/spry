# === STAGE 1: Build dependencies ===
FROM python:3.11-slim AS builder

WORKDIR /build

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir spry-core __DB_EXTRA__

# === STAGE 2: Runtime ===
FROM python:3.11-slim

RUN groupadd -r spry && useradd -r -g spry -d /app -s /sbin/nologin spry \
    && mkdir -p /app && chown spry:spry /app

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=spry:spry src/ ./src/
COPY --chown=spry:spry main.py appsettings.json ./

USER spry

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["gunicorn", "__PACKAGE_NAME__.app:create_app", "-w", "4", "-b", "0.0.0.0:8000"]
