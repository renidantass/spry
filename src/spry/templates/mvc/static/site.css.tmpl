:root {
  --background: #09090b;
  --foreground: #fafafa;
  --card: #111113;
  --card-foreground: #fafafa;
  --muted: #18181b;
  --muted-foreground: #a1a1aa;
  --border: #27272a;
  --input: #18181b;
  --ring: #d4d4d8;
  --primary: #fafafa;
  --primary-foreground: #09090b;
  --secondary: #18181b;
  --secondary-foreground: #fafafa;
  --accent: #18181b;
  --accent-foreground: #fafafa;
  --destructive: #7f1d1d;
  --destructive-foreground: #fafafa;
  --radius: 0.9rem;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.07), transparent 28%),
    linear-gradient(180deg, #09090b, #030303);
  color: var(--foreground);
}

button,
input,
textarea {
  font: inherit;
}

.page-shell {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 32px 0 48px;
}

.page-shell--auth {
  min-height: 100vh;
  display: grid;
  place-items: center;
}

.topbar,
.card,
.metric-card,
.todo-card,
.empty-state,
.auth-card,
.alert {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: rgba(17, 17, 19, 0.92);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.24);
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 28px;
  margin-bottom: 24px;
}

.topbar h1,
.card h2,
.todo-card h3 {
  margin: 0;
  letter-spacing: -0.03em;
}

.topbar p,
.card p,
.feature-list,
.field span,
.todo-card p {
  color: var(--muted-foreground);
}

.eyebrow {
  display: inline-block;
  margin-bottom: 12px;
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #d4d4d8;
}

.hero-actions {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 10px;
}

.hero-actions form {
  margin: 0;
}

.badge,
.pill,
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 32px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--foreground);
  font-size: 0.86rem;
}

.badge--outline,
.status-badge {
  color: var(--muted-foreground);
}

.status-badge--done {
  border-color: rgba(74, 222, 128, 0.3);
  color: #86efac;
  background: rgba(34, 197, 94, 0.1);
}

.layout-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.9fr);
  gap: 24px;
}

.stack {
  display: grid;
  gap: 24px;
  align-content: start;
}

.card {
  padding: 24px;
}

.card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.metric-card {
  padding: 18px;
}

.metric-card small {
  display: block;
  margin-bottom: 8px;
  color: var(--muted-foreground);
}

.metric-card strong {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
}

.todo-list {
  display: grid;
  gap: 14px;
}

.todo-card {
  display: grid;
  gap: 14px;
  padding: 18px;
}

.todo-card__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.todo-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.form-stack {
  display: grid;
  gap: 14px;
}

.field {
  display: grid;
  gap: 8px;
}

.input,
.textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius) - 0.2rem);
  background: var(--input);
  color: var(--foreground);
  outline: none;
}

.input:focus,
.textarea:focus {
  border-color: var(--ring);
  box-shadow: 0 0 0 2px rgba(212, 212, 216, 0.15);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius) - 0.2rem);
  background: var(--secondary);
  color: var(--secondary-foreground);
  cursor: pointer;
}

.button--primary {
  background: var(--primary);
  color: var(--primary-foreground);
}

.button--secondary:hover,
.button--ghost:hover,
.button--primary:hover {
  opacity: 0.92;
}

.button--ghost {
  background: transparent;
}

.feature-list {
  display: grid;
  gap: 10px;
  padding-left: 18px;
  margin: 0;
}

.auth-card {
  width: min(460px, 100%);
  padding: 28px;
}

.auth-card__intro {
  margin-bottom: 18px;
}

.auth-hint {
  margin-top: 16px;
  color: var(--muted-foreground);
}

.alert {
  padding: 14px 16px;
  margin-bottom: 16px;
}

.alert--error {
  border-color: rgba(239, 68, 68, 0.34);
  background: rgba(127, 29, 29, 0.22);
  color: #fecaca;
}

.empty-state {
  display: flex;
  gap: 16px;
  align-items: center;
  padding: 22px;
}

.empty-state__icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 1.35rem;
}

@media (max-width: 920px) {
  .page-shell {
    width: min(100% - 24px, 1180px);
    padding-top: 16px;
  }

  .topbar,
  .layout-grid,
  .metrics-grid,
  .todo-card__title-row {
    grid-template-columns: 1fr;
  }

  .topbar,
  .todo-card__title-row {
    display: grid;
  }

  .layout-grid {
    gap: 18px;
  }
}

@media (max-width: 640px) {
  .page-shell {
    width: min(100% - 16px, 1180px);
  }

  .topbar,
  .card,
  .metric-card,
  .todo-card,
  .empty-state {
    padding: 18px;
  }

  .button {
    width: 100%;
  }

  .todo-card__actions {
    display: grid;
    grid-template-columns: 1fr;
  }
}
